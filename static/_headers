# Cloudflare Pages custom headers.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# The dataset endpoints are intentionally CORS-open so that any browser-
# based notebook, dashboard, or research tool can fetch them without a
# proxy. Cache windows are short enough that a daily cron update is
# visible within minutes, long enough that a viral citation does not
# saturate the origin.

# Site-wide security headers (PageSpeed "Best Practices" / Trust & Safety).
# Conservative on purpose:
#  - HSTS: staged low max-age per Google's own rollout guidance, no
#    includeSubDomains/preload — those are effectively irreversible once a
#    browser caches them, and we haven't audited every subdomain's HTTPS
#    readiness. Raise the max-age over time once confirmed safe.
#  - X-Frame-Options: SAMEORIGIN blocks clickjacking site-wide, with an
#    explicit carve-out below for /embed, whose entire purpose is being
#    iframed by other people's pages (see src/routes/embed).
# Deliberately NOT added here: a full Content-Security-Policy or
# Trusted-Types policy. This site loads several third-party scripts whose
# exact resource origins aren't all visible from the codebase (Cloudflare
# dashboard-injected tags), and Svelte's `{@html}` sinks would need a real
# Trusted Types policy audit — a wrong CSP here fails silently (broken
# resources, no build error) rather than safely. Also skipping COOP for now:
# untested interaction with any window.open()-based share flows.
/*
  Strict-Transport-Security: max-age=86400
  X-Frame-Options: SAMEORIGIN

/embed
  ! X-Frame-Options

/api/prices.json
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Cache-Control: public, max-age=300
  X-Content-Type-Options: nosniff

/data/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff
  # Versioned dataset artifacts (prices.json/ndjson/csv/parquet, SHA256SUMS,
  # CITATION.cff, LICENSE.txt) are files, not pages — keep them out of the
  # search index (GSC "crawled, not indexed"). noindex is a SERP directive
  # only; it does NOT block fetching, so the open-CORS access above still
  # lets notebooks and AI crawlers ingest the data. The /data HTML landing
  # page (path /data, which does not match /data/*) stays indexable.
  X-Robots-Tag: noindex

# Health endpoint is an ops asset, not a page — keep it out of the index.
/health.json
  X-Robots-Tag: noindex

# SvelteKit's hashed bundles — content-addressed, safe to cache forever.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# Sprite art is large and effectively static. One-week TTL with
# stale-while-revalidate lets repeat visits skip the network entirely
# while still picking up re-renders within a reasonable window.
/sprites/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# 3D reference models (shiba.glb etc.) — large, lazy-loaded, effectively
# static. Same rationale as sprite art above; previously uncached.
/models/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Header art + favicon — same rationale, smaller payload.
/header.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/header.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon.png
  Cache-Control: public, max-age=604800

# prices.json is regenerated daily by the cron — short TTL, but allow
# CDN to serve while revalidating so a cache miss never blocks render.
/prices.json
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

# Prerendered HTML. Must NOT be cached at the edge across deploys: each page
# references content-hashed bundles under /_app/immutable, and every Pages
# deploy (several a day from the price/holdings/mining cron) replaces them.
# An edge copy older than the latest deploy points at chunks that now 404, so
# the app never hydrates — slider dead, 3D/Hashweight panels blank. That is
# what s-maxage=86400 + stale-while-revalidate=604800 did here: nothing
# purges the CF cache after a deploy. Pages already serves these files from
# its own global asset store, so max-age=0 costs little; src/app.html also
# reloads once if a bundle still fails to load.
/
  Cache-Control: public, max-age=0, must-revalidate
/data
  Cache-Control: public, max-age=0, must-revalidate
/methodology
  Cache-Control: public, max-age=0, must-revalidate
/btc/*
  Cache-Control: public, max-age=0, must-revalidate
/snapshot/*
  Cache-Control: public, max-age=0, must-revalidate
/snapshot
  Cache-Control: public, max-age=0, must-revalidate
